
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL="openai/gpt-oss-20b"

# Vision model for images and sampled video frames
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Speech-to-text model for audio/video
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Windows Tesseract paths; edit if installed elsewhere.
TESSDATA_PREFIX=C:/Program Files/Tesseract-OCR/tessdata
TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
OCR_LANG=eng

# Optional local username/password login
DOCUMIND_AUTH_ENABLED=false

# Optional storage paths
# CHROMA_PATH=./chroma_db
# METRICS_PATH=./metrics.csv
# FEEDBACK_PATH=./feedback.csv